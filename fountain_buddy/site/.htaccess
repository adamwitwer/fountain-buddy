# Uploaded by `fountain-buddy publish` to adamwitwer.com/birds/. The page changes after
# every run of answers, so NearlyFreeSpeech's edge cache must not hold it for long (it
# held Watchlog's page for 15+ minutes). Images are named by visit and never change, so
# they can be cached for a month.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 60 seconds"
  ExpiresByType text/html "access plus 60 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=60, must-revalidate"
  </FilesMatch>
</IfModule>
