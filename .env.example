# Copy to .env and fill in. Never commit .env.

# Reolink camera
CAMERA_HOST=192.168.1.100
CAMERA_USERNAME=admin
CAMERA_PASSWORD=

# Discord bot (Developer Portal → Bot). It posts photos and reads answers in one channel.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Optional: healthchecks.io ping URL
HEALTHCHECK_URL=

# Optional: where `fountain-buddy publish` uploads the public page, as an SSH host
# (from ~/.ssh/config) and a folder that must end in /birds. Empty: build locally only.
# FB_PUBLISH_DEST=nfsn:/home/public/birds

# Optional: where images, the database and models live (default: ./data)
# FB_DATA_DIR=
